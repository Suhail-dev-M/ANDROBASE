# ==============================================================================
# AndroBase - Git Ignore Rules for Open-Source Distribution
# ==============================================================================

# Node dependencies
node_modules/
.pnp
.pnp.js

# Build and production output
dist/
dist-ssr/
build/
coverage/

# Local runtime data & database storage (DO NOT COMMIT USER DATA OR BACKUPS)
.androbase_data/
storage/
backups/
*.db
*.db.json
*.wal
*.pid
.bootstrap_token

# Environment variables & secrets
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env*.local
.dev.env.json
!.env.example

# Logs and runtime dumps
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Compressed archives & backups
*.tar.gz
*.tgz
*.zip
*.bak

# Temporary and editor files
.DS_Store
*.pem
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Platform / AI Studio internal artifacts
.aistudio/
