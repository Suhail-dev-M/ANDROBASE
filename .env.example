# ==============================================================================
# AndroBase - Example Environment Configuration
# Copy this file to .env and customize values for your deployment.
# NEVER commit your actual .env file or private keys to source control!
# ==============================================================================

# Server Network Binding
# 0.0.0.0 allows other devices on the same Wi-Fi/LAN to access the dashboard
# 127.0.0.1 restricts access strictly to the local smartphone
HOST="0.0.0.0"
PORT=3000
NODE_ENV="production"

# Data Storage Directory
# By default on Termux, this defaults to $HOME/.androbase
# Uncomment to override with a custom path
# ANDROBASE_DATA_DIR="/data/data/com.termux/files/home/.androbase"

# Cryptographic Secret for Session & JWT Token Verification
# In production, generate a secure 64-character hex string:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ANDROBASE_JWT_SECRET="replace-with-a-cryptographically-secure-random-secret"

# LAN Network Exposure
# Enable to allow access from computers on your trusted home Wi-Fi
ANDROBASE_ALLOW_LAN="true"

# Mobile Resource Limits
# Conservative limits designed to prevent Android Low Memory Killer (LMK) termination
ANDROBASE_MAX_UPLOAD_BYTES=20971520   # 20 MB max file upload size
ANDROBASE_MAX_MEMORY_MB=256          # 256 MB max V8 heap allocation

# Optional External API Keys (Server-Side Only - Never Exposed to Frontend)
# GEMINI_API_KEY="your-gemini-api-key-here"
# APP_URL="http://192.168.1.100:3000"
